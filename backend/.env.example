# ==============================================================================
# Trao Backend Environment Configuration
# ==============================================================================

NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/interview_prep

# Session & Security (Secret must be at least 32 characters)
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_COOKIE_NAME=trao.sid
SESSION_TTL_DAYS=7

# Cookie Security Settings:
# - Set COOKIE_SECURE=true when running behind HTTPS/SSL
# - Set COOKIE_SECURE=false if testing over plain HTTP (e.g. http://143.x.x.x:3000)
# - Leave blank to auto-detect based on NODE_ENV
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# LLM Providers (Groq recommended for high-speed free tier, or Grok/Gemini)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROK_API_KEY=
GROK_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_PROVIDER=auto

# Search Providers (Optional: Tavily or Brave. Leave blank for automatic free DuckDuckGo search)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

ALLOW_LOCAL_COMPANY_URLS=false
MAX_CRAWL_PAGES=8
MAX_JD_CHARS=30000

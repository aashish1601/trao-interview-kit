# ==============================================================================
# Trao Production & Environment Configuration
# ==============================================================================

# Session & Security (Generate a secure 64-char string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Production Domain / Origins (comma-separated if multiple domains, e.g. https://yourdomain.com,https://www.yourdomain.com)
FRONTEND_ORIGIN=http://localhost:3000

# Cookie Security Settings:
# - Set COOKIE_SECURE=true when running behind HTTPS/SSL (recommended for live domains)
# - Set COOKIE_SECURE=false if testing over plain HTTP (e.g. http://143.x.x.x:3000 before SSL is installed)
# - Leave blank to auto-detect based on NODE_ENV (defaults to true in production)
COOKIE_SECURE=

# Cookie SameSite: 'lax' (default, recommended for same-origin proxy), 'none' (for cross-site API)
COOKIE_SAME_SITE=lax

# Environment
NODE_ENV=production

# LLM Providers (Groq recommended for high-speed free tier, or Grok/Gemini)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROK_API_KEY=
GROK_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Search Providers (Optional: Tavily or Brave. Leave blank for automatic free DuckDuckGo search)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
